      response.json(rows.map(row=>({id:String(row.id),code:String(row.code),name:String(row.name),durationMonths:Number(row.duration_months),mileageLimit:row.mileage_limit==null?null:Number(row.mileage_limit),terms:warrantyTerms(Number(row.duration_months),row.mileage_limit==null?null:Number(row.mileage_limit))})));
