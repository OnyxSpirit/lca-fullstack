        const [insert]=await connection.execute<ResultSetHeader>(`INSERT INTO vehicles(version_id,agency_id,vehicle_location_id,supplier_id,commercial_origin,commercial_origin_source,is_commercial_stock,vehicle_type,vin,registration_number,body_type,year,first_registration_date,color,interior_color,fuel_type,engine,transmission,fiscal_power,real_power,co2_emissions,mileage,purchase_price,refurbishment_cost,transport_cost,administrative_cost,additional_costs,catalog_price,sale_price,minimum_price,reception_defect_present,reception_defect_description,reception_initial_sale_price,reception_defect_discount,reception_defect_discount_reason,status,entry_date,notes,created_by) VALUES(
