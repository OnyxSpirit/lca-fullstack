    import {TECHNICAL_PROFILE_FIELDS,effectiveTechnicalValues,parseTechnicalValues,resolveTechnicalProfileByVersion} from './vehicle-technical-profile.js';
    
    export const vehicleRouter=Router();
    const DB_STATUSES=['ordered','in_transit','received','preparation','available','demo','reserved','sold','delivered'];
    export const ADMINISTRABLE_VEHICLE_STATUSES=['ordered','in_transit','received','preparation','available','demo'] as const;
    export const COMMERCIAL_PARK_STATUSES=['received','preparation','available','reserved'] as const;
    const ACTIVE_TYPES=['new','used'];
    export const VEHICLE_LOCATION_TYPES=['PARC','SHOWROOM','GARAGE'] as const;
    const isVehicleLocationType=(value:string)=>VEHICLE_LOCATION_TYPES.includes(value as typeof VEHICLE_LOCATION_TYPES[number]);
    export const VEHICLE_FINANCIAL_FIELDS=['purchasePrice','refurbishmentCost','transportCost','administrativeCost','additionalCosts','catalogPrice','salePrice','minimumPrice','hasReceptionDefect','receptionDefectDescription','receptionInitialSalePrice','receptionDefectDiscount','receptionDefectDiscountReason'] as const;
    const idOf=(value:string|string[]|undefined)=>{const id=Array.isArray(value)?value[0]:value;if(!id||!/^[1-9]\d*$/.test(id))throw new HttpError(400,'Identifiant véhicule invalide');return id;};
    const txt=(value:unknown,max=255)=>String(value??'').trim().slice(0,max);
    const optional=(value:unknown,max=255)=>{const valueText=txt(value,max);return valueText||null;};
    const amount=(value:unknown,name:string)=>{const parsed=Number(value??0);if(!Number.isFinite(parsed)||parsed<0||parsed>9999999999999999.99)throw new HttpError(400,`${name} doit être compris entre 0 et 9 999 999 999 999 999,99`);return Math.round(parsed*100)/100;};
    const assertCostTotal=(values:unknown[])=>{const total=values.reduce<number>((sum,value)=>sum+Number(value??0),0);if(!Number.isFinite(total)||total>9999999999999999.99)throw new HttpError(400,'Le coût de revient total dépasse la capacité autorisée');};
    const integer=(value:unknown,name:string,required=false)=>{if((value==null||value==='')&&!required)return null;const parsed=Number(value);if(!Number.isInteger(parsed)||parsed<0)throw new HttpError(400,`${name} doit être un entier positif`);return parsed;};
    const hasFinance=(request:Request)=>grant(request,'vehicles.financials.view')==='AGENCY';
    const grant=(request:Request,permission:string)=>request.agencyRbac?.permissions.get(permission);
    export function vehicleScope(request:Request,permission:string,alias='v',requested:unknown=request.query.agencyId){const value=grant(request,permission),agencyId=request.agencyRbac?.activeAgencyId;if(!agencyId)throw new HttpError(403,'Aucune agence active');if(value==='AGENCY'&&(requested==null||requested===''||String(requested)===agencyId))return{sql:`${alias}.agency_id=?`,params:[agencyId]};if(value==='OWN')throw new HttpError(403,'Le stock véhicules ne possède pas de règle OWN');throw new HttpError(403,`Scope AGENCY requis pour ${permission}`);}
    const assertAgencyPermissionScope=async(request:Request,permission:string,targetAgencyId:string)=>{const scoped=grant(request,permission),current=request.agencyRbac?.activeAgencyId;if(scoped==='AGENCY'&&targetAgencyId===current)return;if(scoped==='OWN')throw new HttpError(403,'Le stock véhicules ne possède pas de règle OWN');throw new HttpError(403,`Agence hors périmètre pour ${permission}`)};
    const agency=async(request:Request,permission:string,requested?:unknown)=>{const current=request.agencyRbac?.activeAgencyId,target=String(requested??current??'');if(!target)throw new HttpError(403,'Aucune agence active');await assertAgencyPermissionScope(request,permission,target);const[row]=await query<RowDataPacket[]>('SELECT id FROM agencies WHERE id=? AND is_active=TRUE',[target]);if(!row)throw new HttpError(400,'Agence invalide ou inactive');return target;};
    const hasFinancialPayload=(body:Record<string,unknown>)=>VEHICLE_FINANCIAL_FIELDS.some(field=>Object.hasOwn(body,field));
    const jsonField=<T>(value:unknown,fallback:T):T=>{if(value==null||value==='')return fallback;if(typeof value!=='string')return value as T;try{return JSON.parse(value) as T}catch{throw new HttpError(400,'Champ JSON invalide')}};
    export function vehicleInventoryViewSql(view:string){if(view==='active')return " AND v.status NOT IN('sold','delivered')";if(view==='sold')return " AND v.status IN('sold','delivered')";if(view==='all')return'';throw new HttpError(400,'Vue de stock invalide')}
    export function vehiclePriceRange(minimum:unknown,maximum:unknown){const parse=(value:unknown,label:string)=>{if(value==null||value==='')return null;const parsed=Number(value);if(!Number.isFinite(parsed)||parsed<0||parsed>9999999999999999.99)throw new HttpError(400,`${label} invalide`);return Math.round(parsed*100)/100},minPrice=parse(minimum,'Prix minimum'),maxPrice=parse(maximum,'Prix maximum');if(minPrice!=null&&maxPrice!=null&&minPrice>maxPrice)throw new HttpError(400,'Le prix minimum doit être inférieur ou égal au prix maximum');return{minPrice,maxPrice}}
    export function vehicleOrderSql(value:unknown){const sort=txt(value)||'date_desc',orders:Record<string,string>={date_desc:'v.entry_date DESC,v.id DESC',date_asc:'v.entry_date ASC,v.id ASC',brand:'b.name ASC,m.name ASC,v.id ASC',model:'m.name ASC,b.name ASC,v.id ASC',price_asc:'v.sale_price ASC,v.id ASC',price_desc:'v.sale_price DESC,v.id DESC'};if(!Object.hasOwn(orders,sort))throw new HttpError(400,'Tri de stock invalide');return orders[sort]!}
    
    const locationScope=(request:Request,permission:string,alias='vl',requested:unknown=request.query.agencyId)=>vehicleScope(request,permission,alias,requested);
    const locationDto=(row:RowDataPacket)=>({id:String(row.id),agencyId:String(row.agency_id),agencyName:row.agency_name,name:String(row.name),type:String(row.type),isActive:Boolean(row.is_active),createdAt:row.created_at,updatedAt:row.updated_at});
    
    vehicleRouter.get('/vehicle-locations',requireAgencyBusinessPermission('vehicles.assignments.view'),asyncHandler(async(request,response)=>{
      const scoped=locationScope(request,'vehicles.assignments.view'),clauses=[scoped.sql],params:unknown[]=[...scoped.params],type=txt(request.query.type);
      if(type){if(!isVehicleLocationType(type))throw new HttpError(400,"Type d'affectation invalide");clauses.push('vl.type=?');params.push(type)}
      if(request.query.active!=null){clauses.push('vl.is_active=?');params.push(String(request.query.active)==='true'?1:0)}
      const rows=await query<RowDataPacket[]>(`SELECT vl.*,a.name agency_name FROM vehicle_locations vl JOIN agencies a ON a.id=vl.agency_id WHERE ${clauses.join(' AND ')} ORDER BY a.name,vl.type,vl.name`,params);
      response.json(rows.map(locationDto));
    }));
    vehicleRouter.post('/vehicle-locations',requireAgencyBusinessPermission('vehicles.assignments.manage'),asyncHandler(async(request,response)=>{
      const agencyId=await agency(request,'vehicles.assignments.manage',request.body.agencyId),name=txt(request.body.name,120),type=txt(request.body.type);
      if(!name)throw new HttpError(400,"Le nom de l'affectation est obligatoire");if(!isVehicleLocationType(type))throw new HttpError(400,"Type d'affectation invalide");
      try{const id=await withCurrentAgencyBusinessAuthorization(request,'vehicles.assignments.manage',async(connection,context)=>{if(context.activeAgencyId!==agencyId)throw new HttpError(409,'AGENCY_CONTEXT_CHANGED');const[result]=await connection.execute<ResultSetHeader>('INSERT INTO vehicle_locations(agency_id,name,type,created_by) VALUES(?,?,?,?)',[agencyId,name,type,context.userId]);return String(result.insertId)});response.status(201).json({id})}catch(error:any){if(error?.code==='ER_DUP_ENTRY')throw new HttpError(409,'Cette affectation existe déjà dans cette agence');throw error}
    }));
    vehicleRouter.patch('/vehicle-locations/:id',requireAgencyBusinessPermission('vehicles.assignments.manage'),asyncHandler(async(request,response)=>{
      const id=idOf(request.params.id),[row]=await query<RowDataPacket[]>('SELECT * FROM vehicle_locations WHERE id=?',[id]);if(!row)throw new HttpError(404,'Affectation introuvable');await assertAgencyPermissionScope(request,'vehicles.assignments.manage',String(row.agency_id));
      const sets:string[]=[],params:unknown[]=[];if(Object.hasOwn(request.body,'name')){const name=txt(request.body.name,120);if(!name)throw new HttpError(400,'Le nom est obligatoire');sets.push('name=?');params.push(name)}if(Object.hasOwn(request.body,'isActive')){sets.push('is_active=?');params.push(Boolean(request.body.isActive))}if(!sets.length)throw new HttpError(400,'Aucune modification reconnue');
      try{await withCurrentAgencyBusinessAuthorization(request,'vehicles.assignments.manage',async(connection,context)=>{const[locked]=await connection.execute<RowDataPacket[]>('SELECT agency_id FROM vehicle_locations WHERE id=? FOR UPDATE',[id]);if(!locked[0]||String(locked[0].agency_id)!==context.activeAgencyId)throw new HttpError(404,'Affectation introuvable');await connection.execute(`UPDATE vehicle_locations SET ${sets.join(',')} WHERE id=?`,[...params,id] as any[])});response.json({success:true})}catch(error:any){if(error?.code==='ER_DUP_ENTRY')throw new HttpError(409,'Cette affectation existe déjà dans cette agence');throw error}
    }));
    vehicleRouter.get('/vehicle-transfer-agencies',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{
      const context=request.agencyRbac!,rows=context.isSuperAdmin?await query<RowDataPacket[]>('SELECT a.id,a.name FROM agencies a WHERE a.is_active=TRUE AND a.id<>? ORDER BY a.name',[context.activeAgencyId]):await query<RowDataPacket[]>(`SELECT DISTINCT a.id,a.name FROM agencies a JOIN user_agencies ua ON ua.agency_id=a.id AND ua.user_id=? AND ua.status='ACTIVE' JOIN user_agency_roles uar ON uar.user_agency_id=ua.id JOIN roles r ON r.id=uar.role_id AND r.is_active=TRUE AND r.is_system=FALSE JOIN role_permissions rp ON rp.role_id=r.id AND rp.scope='AGENCY' JOIN permissions p ON p.id=rp.permission_id AND p.code='vehicles.assign_agency' AND p.is_active=TRUE WHERE a.is_active=TRUE AND a.id<>? ORDER BY a.name`,[context.userId,context.activeAgencyId]);
      response.json(rows.map(row=>({id:String(row.id),name:String(row.name)})));
    }));
    vehicleRouter.get('/vehicle-transfer-locations',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{
      const target=txt(request.query.agencyId),context=request.agencyRbac!;if(!target)throw new HttpError(400,'Agence destination requise');if(!await userHasAgencyPermission(pool,context.userId,target,'vehicles.assign_agency',context.isSuperAdmin))throw new HttpError(403,'Permission destination insuffisante');
      const rows=await query<RowDataPacket[]>(`SELECT vl.*,a.name agency_name FROM vehicle_locations vl JOIN agencies a ON a.id=vl.agency_id WHERE vl.is_active=TRUE AND vl.agency_id=? ORDER BY a.name,vl.type,vl.name`,[target]);
      response.json(rows.map(locationDto));
    }));
    
    export function vehicleStatsQuery(request:Request){
      const scoped=vehicleScope(request,'vehicles.view','v',request.query.agencyId);
      const finance=hasFinance(request);
      const financialScoped=finance?vehicleScope(request,'vehicles.financials.view','v',request.query.agencyId):null;
      const received=`(v.vehicle_order_id IS NULL AND v.entry_date IS NOT NULL OR v.vehicle_order_id IS NOT NULL AND EXISTS(SELECT 1 FROM vehicle_order_receipts vor WHERE vor.vehicle_order_id=v.vehicle_order_id AND JSON_CONTAINS(vor.vehicle_ids,JSON_QUOTE(CAST(v.id AS CHAR)))))`;
      const financialSelect=financialScoped?`,COALESCE(SUM(CASE WHEN ${received} AND v.status IN('received','preparation','available','reserved') AND (${financialScoped.sql}) THEN v.sale_price ELSE 0 END),0) stock_value`:'';
      return{
        sql:`SELECT COUNT(*) total,SUM(NOT ${received}) ordered,SUM(${received}) physical,SUM(v.status='in_transit') in_transit,SUM(v.status='received') received,SUM(v.status='preparation') preparation,SUM(v.status='available') available,SUM(v.status='demo') demo,SUM(v.status='reserved') reserved,SUM(v.status='sold') sold,SUM(v.status='delivered') delivered,SUM(${received} AND v.entry_date<DATE_SUB(CURDATE(),INTERVAL 60 DAY)) dormant${financialSelect} FROM vehicles v WHERE ${commercialStockPredicate()} AND v.archived_at IS NULL AND v.status NOT IN('sold','delivered') AND ${scoped.sql}`,
        params:financialScoped?[...financialScoped.params,...scoped.params]:scoped.params,
        finance,
      };
    }
    
    vehicleRouter.get('/vehicles/stats',requireAgencyBusinessPermission('vehicles.view'),asyncHandler(async(request,response)=>{
      const statsQuery=vehicleStatsQuery(request);
      const [row]=await query<RowDataPacket[]>(statsQuery.sql,statsQuery.params);
      const availableForSale=Number(row?.available??0);
      response.json({total:Number(row?.total??0),physical:Number(row?.physical??0),ordered:Number(row?.ordered??0),inTransit:Number(row?.in_transit??0),received:Number(row?.received??0),preparation:Number(row?.preparation??0),available:availableForSale,availableForSale,demo:Number(row?.demo??0),reserved:Number(row?.reserved??0),sold:Number(row?.sold??0),delivered:Number(row?.delivered??0),dormant:Number(row?.dormant??0),...(statsQuery.finance?{stockValue:Number(row?.stock_value??0)}:{})});
    }));
    
    vehicleRouter.get('/vehicles/location-counts',requireAgencyBusinessPermission('vehicles.view'),asyncHandler(async(request,response)=>{
      const scoped=vehicleScope(request,'vehicles.view'),view=txt(request.query.view)||'active';
      const viewSql=vehicleInventoryViewSql(view);
      const physicallyPresent=`(v.vehicle_order_id IS NULL AND v.entry_date IS NOT NULL OR v.vehicle_order_id IS NOT NULL AND EXISTS(SELECT 1 FROM vehicle_order_receipts vor WHERE vor.vehicle_order_id=v.vehicle_order_id AND JSON_CONTAINS(vor.vehicle_ids,JSON_QUOTE(CAST(v.id AS CHAR)))))`;
