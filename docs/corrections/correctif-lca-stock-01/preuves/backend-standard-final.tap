      const repairOrders=sections.service?await query<RowDataPacket[]>(`SELECT ro.id,ro.order_number,ro.customer_id,ro.status,ro.complaint,ro.created_at FROM repair_orders ro WHERE ro.vehicle_id=? AND ro.agency_id=? AND ${serviceScope!.sql} ORDER BY ro.created_at DESC`,[id,vehicleAgency,...serviceScope!.params]):[];
