      const numericFields=new Set(['year','fiscalPower','realPower','co2Emissions','mileage','supplierId']);
      const amountFields=new Set(['purchasePrice','refurbishmentCost','transportCost','administrativeCost','additionalCosts','catalogPrice','salePrice','minimumPrice','receptionInitialSalePrice','receptionDefectDiscount']);
      if(hasFinancialPayload(request.body)){await assertAgencyPermissionScope(request,'vehicles.financials.view',String(before.agency_id));Object.assign(allowed,{purchasePrice:'purchase_price',refurbishmentCost:'refurbishment_cost',transportCost:'transport_cost',administrativeCost:'administrative_cost',additionalCosts:'additional_costs',catalogPrice:'catalog_price',salePrice:'sale_price',minimumPrice:'minimum_price'})}
      if(hasFinancialPayload(request.body))assertCostTotal(([['purchasePrice','purchase_price'],['refurbishmentCost','refurbishment_cost'],['transportCost','transport_cost'],['administrativeCost','administrative_cost'],['additionalCosts','additional_costs']] as const).map(([field,column])=>Object.hasOwn(request.body,field)?amount(request.body[field],field):before[column]));
      const receptionTouched=['hasReceptionDefect','receptionDefectDescription','receptionInitialSalePrice','receptionDefectDiscount','receptionDefectDiscountReason'].some(field=>Object.hasOwn(request.body,field))||(Boolean(before.reception_defect_present)&&Object.hasOwn(request.body,'salePrice'));
      if(receptionTouched){const explicitSalePrice=Object.hasOwn(request.body,'salePrice')?request.body.salePrice:undefined;const reception=vehicleReceptionPricing({hasReceptionDefect:request.body.hasReceptionDefect??Boolean(before.reception_defect_present),receptionDefectDescription:request.body.receptionDefectDescription??before.reception_defect_description,receptionInitialSalePrice:request.body.receptionInitialSalePrice??explicitSalePrice??before.reception_initial_sale_price??before.sale_price,receptionDefectDiscount:request.body.receptionDefectDiscount??before.reception_defect_discount,receptionDefectDiscountReason:request.body.receptionDefectDiscountReason??before.reception_defect_discount_reason,minimumPrice:request.body.minimumPrice??before.minimum_price});Object.assign(request.body,{hasReceptionDefect:reception.hasReceptionDefect,receptionDefectDescription:reception.receptionDefectDescription,receptionInitialSalePrice:reception.receptionInitialSalePrice,receptionDefectDiscount:reception.receptionDefectDiscount,receptionDefectDiscountReason:reception.receptionDefectDiscountReason,salePrice:reception.finalSalePrice});Object.assign(allowed,{hasReceptionDefect:'reception_defect_present',receptionDefectDescription:'reception_defect_description',receptionInitialSalePrice:'reception_initial_sale_price',receptionDefectDiscount:'reception_defect_discount',receptionDefectDiscountReason:'reception_defect_discount_reason',salePrice:'sale_price'});}
      const sets:string[]=[],params:any[]=[];
      for(const [field,column] of Object.entries(allowed))if(Object.hasOwn(request.body,field)){
        const raw=request.body[field];
        const value=field==='hasReceptionDefect'?Boolean(raw):amountFields.has(field)?amount(raw,field):numericFields.has(field)?integer(raw,field):field==='vin'?String(raw??'').toUpperCase().replace(/[\s-]+/g,''):field==='registrationNumber'?optional(raw,50)?.toUpperCase()??null:optional(raw,['notes','receptionDefectDescription','receptionDefectDiscountReason'].includes(field)?5000:255);
        if(field==='vin'&&!/^[A-Z0-9]{17}$/.test(String(value)))throw new HttpError(400,'Le VIN doit contenir exactement 17 caractères alphanumériques');
        sets.push(`${column}=?`);params.push(value);
      }
      const technicalTouched=Object.hasOwn(request.body,'technicalValues'),technicalValues=parseTechnicalValues(request.body.technicalValues),technicalScope=txt(request.body.technicalScope)||'vehicle';if(technicalTouched&&!['vehicle','profile'].includes(technicalScope))throw new HttpError(400,'Portée technique invalide');
      const warrantyTouched=Object.hasOwn(request.body,'warrantyAssignment');
