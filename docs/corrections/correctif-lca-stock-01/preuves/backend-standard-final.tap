     const create=async()=>{try{if((!form.brandId&&!form.brandNew)||(!form.modelId&&!form.modelNew))throw new Error('Sélectionnez une référence existante ou confirmez explicitement son ajout.');const quantity=Number(form.quantity);if(!Number.isInteger(quantity)||quantity<1||quantity>1000)throw new Error('La quantité doit être un entier de 1 à 1 000.');const image=illustration?await optimizeImage(illustration):undefined;await actions.create.mutateAsync({...(form.brandId?{brandId:form.brandId}:{brandName:form.brandName}),...(form.modelId?{modelId:form.modelId}:{modelName:form.modelName}),versionId:form.versionId||undefined,quantity,clientRequestId:createKey.current,...(image?{illustration:{dataUrl:image.dataUrl,name:image.name}}:{})});createKey.current=uuid();setCreating(false);setIllustration(undefined);setForm({brandId:'',brandName:'',brandNew:false,modelId:'',modelName:'',modelNew:false,versionId:'',quantity:'1'});toast({type:'success',title:'Commande enregistrée',description:'Les références et les fiches individuelles sont à jour.'})}catch(error){fail('Commande impossible',error)}};
     const receive=async()=>{if(!receiptOrder)return;try{await actions.receive.mutateAsync({id:receiptOrder.id,quantity:Number(receiptQuantity),clientRequestId:receiptKey.current});receiptKey.current=uuid();setReceiptOrder(undefined);toast({type:'success',title:'Réception enregistrée',description:'Le stock physique et le reliquat ont été actualisés.'})}catch(error){fail('Réception impossible',error)}};
     return <div className="space-y-5">{!embedded&&<PageHeader title="Modèles sur commande" subtitle="Commandes en flotte et réceptions de l’agence active." breadcrumbs={[{label:'Accueil',href:'/dashboard'},{label:'Stock',href:'/vehicles'},{label:'Modèles sur commande'}]} actions={canManage?<Button icon={<Plus className="h-4 w-4"/>} onClick={()=>setCreating(true)}>Nouvelle commande</Button>:undefined}/>} {embedded&&canManage&&<div className="flex justify-end"><Button icon={<Plus className="h-4 w-4"/>} onClick={()=>setCreating(true)}>Nouvelle commande</Button></div>}
     <Card padding="none"><div className="flex flex-wrap gap-3 border-b p-4"><div className="relative min-w-56 flex-1"><Search className="absolute left-3 top-2.5 h-4 w-4 text-slate-400"/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Référence, marque, modèle, version…" className="w-full rounded-lg border py-2 pl-9 pr-3 text-xs"/></div><select aria-label="Filtrer par marque" className="rounded-lg border p-2 text-xs" value={brandId} onChange={e=>{setBrandId(e.target.value);setModelId('')}}><option value="">Toutes les marques</option>{references.data?.brands.map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select><select aria-label="Filtrer par modèle" className="rounded-lg border p-2 text-xs" value={modelId} onChange={e=>setModelId(e.target.value)}><option value="">Tous les modèles</option>{models.map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select><select aria-label="Filtrer par état" className="rounded-lg border p-2 text-xs" value={status} onChange={e=>setStatus(e.target.value)}><option value="">Tous les états</option><option value="ordered">En commande</option><option value="partially_received">Partiellement réceptionnée</option><option value="received">Réceptionnée</option></select></div>
     <div className="overflow-x-auto"><table className="w-full min-w-[900px] text-left text-xs"><thead className="bg-slate-50"><tr><th className="p-3">Référence</th><th>Marque</th><th>Modèle</th><th>Date de commande</th><th>Commandés</th><th>Réceptionnés</th><th>Restants</th><th>État</th><th>Actions</th></tr></thead><tbody>{orders.data?.items.map(order=><tr key={order.id} className="border-t"><td className="p-3 font-bold">{order.orderNumber}</td><td>{order.brand}</td><td><div className="flex items-center gap-2">{order.illustrationUrl&&<img alt="Illustration de commande" src={assetUrl(order.illustrationUrl)} className="h-9 w-12 rounded object-cover"/>}<span>{order.model}{order.version?` — ${order.version}`:''}</span></div></td><td>{new Date(order.orderedAt).toLocaleDateString('fr-CG')}</td><td>{order.quantityOrdered}</td><td>{order.quantityReceived}</td><td>{order.quantityRemaining}</td><td><Badge variant={order.status==='received'?'success':order.status==='partially_received'?'warning':'default'}>{statusLabel(order.status)}</Badge></td><td><div className="flex gap-1"><Button size="xs" variant="outline" icon={<Eye className="h-3 w-3"/>} onClick={()=>setDetailId(order.id)}>Consulter</Button><Button size="xs" variant="outline" icon={<Truck className="h-3 w-3"/>} onClick={()=>navigate(`/vehicles?vehicleOrderId=${order.id}`)}>Voir les véhicules</Button>{canManage&&order.quantityRemaining>0&&<Button size="xs" onClick={()=>{receiptKey.current=uuid();setReceiptOrder(order);setReceiptQuantity(String(order.quantityRemaining))}}>Réceptionner</Button>}</div></td></tr>)}{orders.isSuccess&&!orders.data?.items.length&&<tr><td colSpan={9} className="p-8 text-center text-slate-500">Aucune commande enregistrée.</td></tr>}</tbody></table></div><ServerPagination page={page} pageSize={pageSize} total={orders.data?.total??0} totalPages={orders.data?.totalPages??0} loading={orders.isFetching} label="commande(s)" onPageChange={setPage} onPageSizeChange={size=>{setPageSize(size);setPage(1)}}/></Card>
     <Modal isOpen={creating} onClose={()=>setCreating(false)} title="Nouvelle commande" maxWidth="lg"><div className="grid gap-4 sm:grid-cols-2">
      <CreatableReferenceField label="Marque" items={references.data?.brands??[]} value={form.brandName} selectedId={form.brandId} isNew={form.brandNew} onChange={(value,id,isNew)=>setForm({...form,brandName:value,brandId:id,brandNew:isNew,modelId:'',modelName:'',modelNew:false,versionId:''})}/>
      <CreatableReferenceField label="Modèle" items={formModels} value={form.modelName} selectedId={form.modelId} isNew={form.modelNew} disabled={!form.brandId&&!form.brandNew} onChange={(value,id,isNew)=>setForm({...form,modelName:value,modelId:id,modelNew:isNew,versionId:''})}/>
      <label className="text-xs font-semibold">Version (facultative)<select disabled={!form.modelId} className="mt-1 w-full rounded border p-2 disabled:bg-slate-100" value={form.versionId} onChange={e=>setForm({...form,versionId:e.target.value})}><option value="">Non précisée</option>{versions.map(item=><option key={item.id} value={item.id}>{item.name}</option>)}</select><span className="mt-1 block font-normal text-slate-500">Disponible uniquement pour un modèle existant.</span></label>
      <label className="text-xs font-semibold">Quantité *<input className="mt-1 w-full rounded border p-2" type="number" min="1" max="1000" step="1" value={form.quantity} onChange={e=>setForm({...form,quantity:e.target.value})}/></label>
      <label className="text-xs font-semibold sm:col-span-2">Photographie illustrative (facultative)<input className="mt-1 block w-full text-xs" type="file" accept="image/jpeg,image/png,image/webp" onChange={e=>setIllustration(e.target.files?.[0])}/><span className="mt-1 block font-normal text-slate-500">Illustration commune de la commande, distincte des photographies réelles.</span></label>
     </div><div className="mt-5 flex justify-end gap-2"><Button variant="outline" onClick={()=>setCreating(false)}>Annuler</Button><Button loading={actions.create.isPending} disabled={(!form.brandId&&!form.brandNew)||(!form.modelId&&!form.modelNew)||!Number.isInteger(Number(form.quantity))||Number(form.quantity)<1||Number(form.quantity)>1000} onClick={()=>void create()}>Créer la commande</Button></div></Modal>
     <Modal isOpen={Boolean(receiptOrder)} onClose={()=>setReceiptOrder(undefined)} title={`Réception ${receiptOrder?.orderNumber??''}`} maxWidth="sm"><div className="space-y-3 text-sm"><p><b>{receiptOrder?.brand} {receiptOrder?.model}</b></p><div className="grid grid-cols-3 gap-2 rounded bg-slate-50 p-3 text-center"><span>Commandés<br/><b>{receiptOrder?.quantityOrdered}</b></span><span>Réceptionnés<br/><b>{receiptOrder?.quantityReceived}</b></span><span>Restants<br/><b>{receiptOrder?.quantityRemaining}</b></span></div><label className="block text-xs font-semibold">Quantité à réceptionner<input type="number" min="1" max={receiptOrder?.quantityRemaining} step="1" value={receiptQuantity} onChange={e=>setReceiptQuantity(e.target.value)} className="mt-1 w-full rounded border p-2"/></label><div className="flex justify-end gap-2"><Button variant="outline" onClick={()=>setReceiptOrder(undefined)}>Annuler</Button><Button loading={actions.receive.isPending} disabled={!Number.isInteger(Number(receiptQuantity))||Number(receiptQuantity)<1||Number(receiptQuantity)>(receiptOrder?.quantityRemaining??0)} onClick={()=>void receive()}>Confirmer la réception</Button></div></div></Modal>
     <Modal isOpen={Boolean(detailId)} onClose={()=>setDetailId(undefined)} title={detail.data?.orderNumber??'Détail de la commande'} maxWidth="2xl">{detail.isLoading?<p>Chargement…</p>:detail.isError?<p className="text-red-700">Lecture impossible.</p>:detail.data&&<div className="space-y-5 text-sm"><div className="grid gap-2 sm:grid-cols-2"><p><b>Modèle :</b> {detail.data.brand} {detail.data.model}{detail.data.version?` — ${detail.data.version}`:''}</p><p><b>Agence :</b> {detail.data.agencyName}</p><p><b>Date :</b> {new Date(detail.data.orderedAt).toLocaleString('fr-CG')}</p><p><b>Créée par :</b> {detail.data.createdByName}</p><p><b>Quantités :</b> {detail.data.quantityOrdered} commandés · {detail.data.quantityReceived} réceptionnés · {detail.data.quantityRemaining} restants</p><p><b>État :</b> {statusLabel(detail.data.status)}</p></div><section><h3 className="mb-2 font-bold">Historique des réceptions</h3>{detail.data.receipts.length?<div className="overflow-x-auto"><table className="w-full text-xs"><thead><tr><th className="text-left">Identifiant</th><th>Date et heure</th><th>Quantité</th><th>Responsable</th><th>Véhicules</th></tr></thead><tbody>{detail.data.receipts.map(item=><tr className="border-t" key={item.id}><td className="py-2">#{item.id}</td><td>{new Date(item.receivedAt).toLocaleString('fr-CG')}</td><td>{item.quantityReceived}</td><td>{item.receivedByName}</td><td>{item.vehicleIds.join(', ')}</td></tr>)}</tbody></table></div>:<p className="text-slate-500">Aucune réception enregistrée.</p>}</section><div className="flex justify-end"><Button icon={<Truck className="h-4 w-4"/>} onClick={()=>navigate(`/vehicles?vehicleOrderId=${detail.data!.id}`)}>Voir les véhicules</Button></div></div>}</Modal>
     </div>;
    };
    
