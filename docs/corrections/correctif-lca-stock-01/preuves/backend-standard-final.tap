        const id=String(insert.insertId);await connection.execute('UPDATE vehicles SET stock_number=?,technical_overrides=? WHERE id=?',[`STK-${String(insert.insertId).padStart(6,'0')}`,technicalScope==='vehicle'&&Object.keys(technicalValues).length?JSON.stringify(technicalValues):null,id]);if(Object.hasOwn(request.body,'warrantyAssignment'))await persistWarrantyAssignment(connection,id,request.body.warrantyAssignment,request.user!.sub);await connection.execute(`INSERT INTO vehicle_status_history(vehicle_id,old_status,new_status,changed_by,reason) VALUES(?,NULL,?,?,'Entrée initiale en stock')`,[id,initialStatus,request.user!.sub]);const[movement]=await connection.execute<ResultSetHeader>(`INSERT INTO vehicle_movements(vehicle_id,to_vehicle_location_id,to_agency_id,movement_type,reason,performed_by) VALUES(?,?,?,'entry','Entrée initiale en stock',?)`,[id,locationId,agencyId,request.user!.sub]);
        for(const name of featureNames){let [rows]=await connection.execute<RowDataPacket[]>('SELECT id FROM vehicle_features WHERE name=?',[name]);let featureId=rows[0]?.id;if(!featureId){const [created]=await connection.execute<ResultSetHeader>('INSERT INTO vehicle_features(name) VALUES(?)',[name]);featureId=created.insertId}await connection.execute('INSERT IGNORE INTO vehicle_feature_assignments(vehicle_id,feature_id) VALUES(?,?)',[id,featureId])}
        await insertVehicleImages(connection,id,request.user!.sub,staged,0,true);await writeAudit(connection,request,{module:'vehicles',entityType:'vehicle',entityId:id,action:'vehicle.stock_entry.created',newValues:{hasReceptionDefect:reception.hasReceptionDefect,receptionDefectDescription:reception.receptionDefectDescription,receptionInitialSalePrice:reception.receptionInitialSalePrice,receptionDefectDiscount:reception.receptionDefectDiscount,receptionDefectDiscountReason:reception.receptionDefectDiscountReason,finalSalePrice:reception.finalSalePrice,technicalScope,technicalValues}});await finalizeVehicleImages(staged);return{id,agencyId:String(agencyId),movementId:String(movement.insertId)};
      }),{isPersisted:files=>vehicleImageFilesPersisted(files,undefined,vin)});
      await requireBusinessArchive(`vehicle-movement:${result.movementId}:posted`,()=>archiveVehicleMovement(result.movementId,request.user!.sub));await notify(request,result.id,result.agencyId,'vehicles:created','Nouveau véhicule en stock',`${brandName} ${modelName} (${vin}) a été enregistré`);response.status(201).json(mapVehicle(await accessible(result.id,request,'vehicles.create')));
    }));
    
    vehicleRouter.patch('/vehicles/:id',requireAgencyBusinessPermission('vehicles.update'),asyncHandler(async(request,response)=>{
      const id=idOf(request.params.id),before=await accessible(id,request,'vehicles.update');
      assertStockVehicleMutable(before.status);
      if(Object.hasOwn(request.body,'locationId'))throw new HttpError(409,"Utilisez l'action Transférer pour modifier l'affectation physique");
      if(Object.hasOwn(request.body,'vehicleType')&&!ACTIVE_TYPES.includes(txt(request.body.vehicleType)))throw new HttpError(400,'Le type doit être VN ou VO');
      const allowed:Record<string,string>={vin:'vin',vehicleType:'vehicle_type',registrationNumber:'registration_number',bodyType:'body_type',year:'year',firstRegistrationDate:'first_registration_date',color:'color',interiorColor:'interior_color',fuelType:'fuel_type',engine:'engine',transmission:'transmission',fiscalPower:'fiscal_power',realPower:'real_power',co2Emissions:'co2_emissions',mileage:'mileage',supplierId:'supplier_id',notes:'notes'};
      const numericFields=new Set(['year','fiscalPower','realPower','co2Emissions','mileage','supplierId']);
      const amountFields=new Set(['purchasePrice','refurbishmentCost','transportCost','administrativeCost','additionalCosts','catalogPrice','salePrice','minimumPrice','receptionInitialSalePrice','receptionDefectDiscount']);
      if(hasFinancialPayload(request.body)){await assertAgencyPermissionScope(request,'vehicles.financials.view',String(before.agency_id));Object.assign(allowed,{purchasePrice:'purchase_price',refurbishmentCost:'refurbishment_cost',transportCost:'transport_cost',administrativeCost:'administrative_cost',additionalCosts:'additional_costs',catalogPrice:'catalog_price',salePrice:'sale_price',minimumPrice:'minimum_price'})}
      if(hasFinancialPayload(request.body))assertCostTotal(([['purchasePrice','purchase_price'],['refurbishmentCost','refurbishment_cost'],['transportCost','transport_cost'],['administrativeCost','administrative_cost'],['additionalCosts','additional_costs']] as const).map(([field,column])=>Object.hasOwn(request.body,field)?amount(request.body[field],field):before[column]));
      const receptionTouched=['hasReceptionDefect','receptionDefectDescription','receptionInitialSalePrice','receptionDefectDiscount','receptionDefectDiscountReason'].some(field=>Object.hasOwn(request.body,field))||(Boolean(before.reception_defect_present)&&Object.hasOwn(request.body,'salePrice'));
      if(receptionTouched){const explicitSalePrice=Object.hasOwn(request.body,'salePrice')?request.body.salePrice:undefined;const reception=vehicleReceptionPricing({hasReceptionDefect:request.body.hasReceptionDefect??Boolean(before.reception_defect_present),receptionDefectDescription:request.body.receptionDefectDescription??before.reception_defect_description,receptionInitialSalePrice:request.body.receptionInitialSalePrice??explicitSalePrice??before.reception_initial_sale_price??before.sale_price,receptionDefectDiscount:request.body.receptionDefectDiscount??before.reception_defect_discount,receptionDefectDiscountReason:request.body.receptionDefectDiscountReason??before.reception_defect_discount_reason,minimumPrice:request.body.minimumPrice??before.minimum_price});Object.assign(request.body,{hasReceptionDefect:reception.hasReceptionDefect,receptionDefectDescription:reception.receptionDefectDescription,receptionInitialSalePrice:reception.receptionInitialSalePrice,receptionDefectDiscount:reception.receptionDefectDiscount,receptionDefectDiscountReason:reception.receptionDefectDiscountReason,salePrice:reception.finalSalePrice});Object.assign(allowed,{hasReceptionDefect:'reception_defect_present',receptionDefectDescription:'reception_defect_description',receptionInitialSalePrice:'reception_initial_sale_price',receptionDefectDiscount:'reception_defect_discount',receptionDefectDiscountReason:'reception_defect_discount_reason',salePrice:'sale_price'});}
      const sets:string[]=[],params:any[]=[];
      for(const [field,column] of Object.entries(allowed))if(Object.hasOwn(request.body,field)){
        const raw=request.body[field];
        const value=field==='hasReceptionDefect'?Boolean(raw):amountFields.has(field)?amount(raw,field):numericFields.has(field)?integer(raw,field):field==='vin'?String(raw??'').toUpperCase().replace(/[\s-]+/g,''):field==='registrationNumber'?optional(raw,50)?.toUpperCase()??null:optional(raw,['notes','receptionDefectDescription','receptionDefectDiscountReason'].includes(field)?5000:255);
        if(field==='vin'&&!/^[A-Z0-9]{17}$/.test(String(value)))throw new HttpError(400,'Le VIN doit contenir exactement 17 caractères alphanumériques');
        sets.push(`${column}=?`);params.push(value);
      }
      const technicalTouched=Object.hasOwn(request.body,'technicalValues'),technicalValues=parseTechnicalValues(request.body.technicalValues),technicalScope=txt(request.body.technicalScope)||'vehicle';if(technicalTouched&&!['vehicle','profile'].includes(technicalScope))throw new HttpError(400,'Portée technique invalide');
      const warrantyTouched=Object.hasOwn(request.body,'warrantyAssignment');
      if(!sets.length&&!technicalTouched&&!warrantyTouched)throw new HttpError(400,'Aucune modification reconnue');
      await withCurrentAgencyBusinessAuthorization(request,'vehicles.update',async(connection,context)=>{
        const[locked]=await connection.execute<RowDataPacket[]>('SELECT agency_id,status,version_id,technical_overrides FROM vehicles WHERE id=? FOR UPDATE',[id]);if(!locked[0]||String(locked[0].agency_id)!==context.activeAgencyId)throw new HttpError(404,'Véhicule introuvable');assertStockVehicleMutable(locked[0].status);if(hasFinancialPayload(request.body)&&context.permissions.get('vehicles.financials.view')!=='AGENCY')throw new HttpError(403,'Permission financière agence requise');
        if(Object.hasOwn(request.body,'supplierId'))await vehicleSupplier(connection,request.body.supplierId);
        if(sets.length)await connection.execute(`UPDATE vehicles SET ${sets.join(',')} WHERE id=?`,[...params,id]);
        if(technicalTouched){const lockedVehicle=locked[0];if(!lockedVehicle)throw new HttpError(404,'Véhicule introuvable');if(technicalScope==='profile')await writeCommonTechnicalProfile(connection,request,lockedVehicle.version_id,technicalValues,request.body.profileRevision);else await connection.execute('UPDATE vehicles SET technical_overrides=? WHERE id=?',[Object.keys(technicalValues).length?JSON.stringify(technicalValues):null,id])}
        if(warrantyTouched)await persistWarrantyAssignment(connection,id,request.body.warrantyAssignment,request.user!.sub);
        if(request.body.salePrice!=null||request.body.minimumPrice!=null)await connection.execute('INSERT INTO vehicle_price_history(vehicle_id,old_sale_price,new_sale_price,old_minimum_price,new_minimum_price,changed_by,reason) VALUES(?,?,?,?,?,?,?)',[id,before.sale_price,request.body.salePrice??before.sale_price,before.minimum_price,request.body.minimumPrice??before.minimum_price,request.user!.sub,optional(request.body.reason)]);
        await writeAudit(connection,request,{module:'vehicles',entityType:'vehicle',entityId:id,action:'update',oldValues:mapVehicle(before,true),newValues:{...request.body,technicalScope,technicalValues}});
      });
      await notify(request,id,String(before.agency_id),'vehicles:updated','Véhicule modifié',`${before.stock_number} a été mis à jour`);
      response.json(mapVehicle(await accessible(id,request,'vehicles.update')));
    }));
    
    export function assertManualVehicleTransition(current:string,next:string){if(!ADMINISTRABLE_VEHICLE_STATUSES.includes(current as never))throw new HttpError(409,`Le statut ${current} n'est plus administrable depuis Stock Véhicules`);if(!ADMINISTRABLE_VEHICLE_STATUSES.includes(next as never))throw new HttpError(409,`Le statut ${next} doit être produit par son workflow métier`);if(current===next)throw new HttpError(409,'Le véhicule possède déjà ce statut')}
    async function userHasAgencyPermission(runner:{execute:PoolConnection['execute']},userId:string,agencyId:string,permission:string,isSuperAdmin=false){if(isSuperAdmin)return true;const[rows]=await runner.execute<RowDataPacket[]>(`SELECT 1 FROM user_agencies ua JOIN user_agency_roles uar ON uar.user_agency_id=ua.id JOIN roles r ON r.id=uar.role_id AND r.is_active=TRUE AND r.is_system=FALSE JOIN role_permissions rp ON rp.role_id=r.id AND rp.scope='AGENCY' JOIN permissions p ON p.id=rp.permission_id AND p.is_active=TRUE WHERE ua.user_id=? AND ua.agency_id=? AND ua.status='ACTIVE' AND p.code=? LIMIT 1`,[userId,agencyId,permission]);return Boolean(rows[0])}
    async function notifyTransferState(request:Request,transferId:string){
      const[row]=await query<RowDataPacket[]>('SELECT vehicle_id,source_agency_id,destination_agency_id,status FROM vehicle_interagency_transfers WHERE id=?',[transferId]);
      if(!row)return;
      const labels:Record<string,string>={IN_TRANSIT:'expédié',RECEIVED:'réceptionné',RETURN_REQUIRED:'à retourner',CANCELLED:'annulé'},label=labels[String(row.status)]??String(row.status),eventType=`vehicle.transfer.${String(row.status).toLowerCase()}`;
      for(const agencyId of [row.source_agency_id,row.destination_agency_id])emitToAgency(String(agencyId),'vehicles:transferred',{vehicleId:String(row.vehicle_id),transferId,status:row.status});
      await Promise.all([row.source_agency_id,row.destination_agency_id].map(agencyId=>notifyPermissions({agencyId:String(agencyId),permissions:['vehicles.view'],excludeUserIds:[request.user!.sub],subject:`Transfert véhicule ${label}`,message:`Le transfert #${transferId} est ${label}.`,eventType,referenceType:'vehicle-transfer',referenceId:transferId,eventKey:`${eventType}:${transferId}:${agencyId}`,priority:'high',actorType:'human',actorUserId:request.user!.sub})));
    }
    
    vehicleRouter.use('/vehicle-interagency-transfers/:id',(request,response,next)=>{
      if(request.method==='POST')response.once('finish',()=>{if(response.statusCode>=200&&response.statusCode<300)void notifyTransferState(request,idOf(request.params.id)).catch(()=>undefined)});
      next();
    });
    vehicleRouter.patch('/vehicles/:id/status',requireAgencyBusinessPermission('vehicles.status.update'),asyncHandler(async(request,response)=>{const id=idOf(request.params.id),row=await accessible(id,request,'vehicles.status.update'),next=txt(request.body.status),reason=txt(request.body.reason,255);assertManualVehicleTransition(String(row.status),next);if(!reason)throw new HttpError(400,'Le motif du changement de statut est obligatoire');if(next==='available'&&(row.vehicle_location_id==null||!row.location_active||!isVehicleLocationType(String(row.location_type))))throw new HttpError(409,'Un véhicule disponible doit être affecté à un Parc, un Showroom ou un Garage actif');await withCurrentAgencyBusinessAuthorization(request,'vehicles.status.update',async(connection,context)=>{const[rows]=await connection.execute<RowDataPacket[]>('SELECT agency_id,status,vehicle_location_id FROM vehicles WHERE id=? FOR UPDATE',[id]),current=rows[0];if(!current||String(current.agency_id)!==context.activeAgencyId)throw new HttpError(404,'Véhicule introuvable');assertManualVehicleTransition(String(current.status),next);await connection.execute('UPDATE vehicles SET status=? WHERE id=?',[next,id]);await connection.execute('INSERT INTO vehicle_status_history(vehicle_id,old_status,new_status,changed_by,reason) VALUES(?,?,?,?,?)',[id,current.status,next,context.userId,reason])});await notify(request,id,String(row.agency_id),'vehicles:status-changed','Statut véhicule modifié',`${row.stock_number}: ${row.status} → ${next}`);response.json(mapVehicle(await accessible(id,request,'vehicles.status.update')));}));
    
    vehicleRouter.post('/vehicles/:id/location',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{const id=idOf(request.params.id),row=await accessible(id,request,'vehicles.assign_agency'),reason=txt(request.body.reason,255);if(!reason)throw new HttpError(400,'Le motif du changement est obligatoire');assertStockVehicleMutable(row.status);const movementId=await withCurrentAgencyBusinessAuthorization(request,'vehicles.assign_agency',async(connection,context)=>{const[locked]=await connection.execute<RowDataPacket[]>('SELECT agency_id,vehicle_location_id,status FROM vehicles WHERE id=? FOR UPDATE',[id]),current=locked[0];if(!current||String(current.agency_id)!==context.activeAgencyId)throw new HttpError(404,'Véhicule introuvable');assertStockVehicleMutable(current.status);const validLocationId=await vehicleLocation(connection,context.activeAgencyId!,request.body.toLocationId);if(String(current.vehicle_location_id??'')===String(validLocationId??''))throw new HttpError(409,"Le véhicule possède déjà cette affectation");await connection.execute('UPDATE vehicles SET vehicle_location_id=? WHERE id=?',[validLocationId,id]);const[result]=await connection.execute<ResultSetHeader>(`INSERT INTO vehicle_movements(vehicle_id,from_vehicle_location_id,to_vehicle_location_id,from_agency_id,to_agency_id,movement_type,reason,performed_by) VALUES(?,?,?,?,?,'transfer',?,?)`,[id,current.vehicle_location_id,validLocationId,current.agency_id,current.agency_id,reason,context.userId]);return String(result.insertId)});await requireBusinessArchive(`vehicle-movement:${movementId}:posted`,()=>archiveVehicleMovement(movementId,request.user!.sub));await notify(request,id,String(row.agency_id),'vehicles:transferred','Emplacement véhicule modifié',`${row.stock_number}: ${reason}`);response.json({success:true,movementId});}));
    
    vehicleRouter.post('/vehicles/:id/interagency-transfers',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{const vehicleId=idOf(request.params.id),destinationAgencyId=String(integer(request.body.destinationAgencyId,'Agence destination',true)),reason=txt(request.body.reason,255),reference=optional(request.body.reference,120),observations=optional(request.body.observations,5000);if(!reason)throw new HttpError(400,'Le motif du transfert est obligatoire');const transferId=await withCurrentAgencyBusinessAuthorization(request,'vehicles.assign_agency',async(connection,context)=>{if(destinationAgencyId===context.activeAgencyId)throw new HttpError(400,'Utilisez le changement d’emplacement dans une même agence');if(!await userHasAgencyPermission(connection,context.userId,destinationAgencyId,'vehicles.assign_agency',context.isSuperAdmin))throw new HttpError(403,'Permission destination insuffisante');const[agencies]=await connection.execute<RowDataPacket[]>('SELECT id,is_active FROM agencies WHERE id IN(?,?) FOR SHARE',[context.activeAgencyId,destinationAgencyId]);if(agencies.length!==2||agencies.some(item=>!item.is_active))throw new HttpError(409,'Agence source ou destination inactive');const[vehicles]=await connection.execute<RowDataPacket[]>('SELECT id,vin,agency_id,vehicle_location_id,status FROM vehicles WHERE id=? FOR UPDATE',[vehicleId]),vehicle=vehicles[0];if(!vehicle||String(vehicle.agency_id)!==context.activeAgencyId)throw new HttpError(404,'Véhicule introuvable');if(['reserved','sold','delivered','in_transit'].includes(String(vehicle.status)))throw new HttpError(409,'Ce statut véhicule interdit un transfert inter-agences');const[active]=await connection.execute<RowDataPacket[]>("SELECT id FROM vehicle_interagency_transfers WHERE vehicle_id=? AND status IN('PENDING_SHIPMENT','IN_TRANSIT','RETURN_REQUIRED') FOR UPDATE",[vehicleId]);if(active[0])throw new HttpError(409,'Un transfert est déjà actif pour ce véhicule');const[result]=await connection.execute<ResultSetHeader>(`INSERT INTO vehicle_interagency_transfers(vehicle_id,vin_snapshot,source_agency_id,destination_agency_id,source_location_id,original_vehicle_status,reason,external_reference,observations,initiated_by) VALUES(?,?,?,?,?,?,?,?,?,?)`,[vehicleId,vehicle.vin,vehicle.agency_id,destinationAgencyId,vehicle.vehicle_location_id,vehicle.status,reason,reference,observations,context.userId]);await connection.execute("INSERT INTO vehicle_interagency_transfer_history(transfer_id,old_status,new_status,reason,performed_by) VALUES(?,NULL,'PENDING_SHIPMENT',?,?)",[result.insertId,reason,context.userId]);return String(result.insertId)});await Promise.all([notifyPermissions({agencyId:String(request.agencyRbac!.activeAgencyId),permissions:['vehicles.view'],excludeUserIds:[request.user!.sub],subject:'Transfert véhicule initié',message:`Transfert #${transferId} en attente d’expédition`,eventType:'vehicle.transfer.initiated',referenceType:'vehicle-transfer',referenceId:transferId,priority:'high',actorType:'human',actorUserId:request.user!.sub}),notifyPermissions({agencyId:destinationAgencyId,permissions:['vehicles.assign_agency'],excludeUserIds:[request.user!.sub],subject:'Transfert véhicule à recevoir',message:`Le transfert #${transferId} est en attente d’expédition`,eventType:'vehicle.transfer.initiated',referenceType:'vehicle-transfer',referenceId:transferId,priority:'high',actorType:'human',actorUserId:request.user!.sub})]);response.status(201).json({id:transferId,status:'PENDING_SHIPMENT'});}));
    
    vehicleRouter.post('/vehicle-interagency-transfers/:id/dispatch',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{const transferId=idOf(request.params.id);const movementId=await withCurrentAgencyBusinessAuthorization(request,'vehicles.assign_agency',async(connection,context)=>{const[rows]=await connection.execute<RowDataPacket[]>('SELECT * FROM vehicle_interagency_transfers WHERE id=? FOR UPDATE',[transferId]),transfer=rows[0];if(!transfer)throw new HttpError(404,'Transfert introuvable');if(String(transfer.source_agency_id)!==context.activeAgencyId)throw new HttpError(403,'Expédition hors de l’agence source active');if(transfer.status!=='PENDING_SHIPMENT')throw new HttpError(409,'Le transfert n’est plus en attente d’expédition');const[vehicles]=await connection.execute<RowDataPacket[]>('SELECT agency_id,status,vehicle_location_id FROM vehicles WHERE id=? FOR UPDATE',[transfer.vehicle_id]),vehicle=vehicles[0];if(!vehicle||String(vehicle.agency_id)!==context.activeAgencyId||['reserved','sold','delivered','in_transit'].includes(String(vehicle.status)))throw new HttpError(409,'Le véhicule ne peut plus être expédié');await connection.execute("UPDATE vehicle_interagency_transfers SET status='IN_TRANSIT',shipped_by=?,shipped_at=NOW(),version=version+1 WHERE id=?",[context.userId,transferId]);await connection.execute("UPDATE vehicles SET status='in_transit',vehicle_location_id=NULL WHERE id=?",[transfer.vehicle_id]);await connection.execute("INSERT INTO vehicle_status_history(vehicle_id,old_status,new_status,changed_by,reason) VALUES(?,?,'in_transit',?,'Transfert inter-agences expédié')",[transfer.vehicle_id,vehicle.status,context.userId]);const[movement]=await connection.execute<ResultSetHeader>(`INSERT INTO vehicle_movements(vehicle_id,from_vehicle_location_id,from_agency_id,to_agency_id,movement_type,reference_type,reference_id,reason,performed_by) VALUES(?,?,?,?,'transfer','vehicle_interagency_transfer',?,?,?)`,[transfer.vehicle_id,vehicle.vehicle_location_id,transfer.source_agency_id,transfer.destination_agency_id,transferId,transfer.reason,context.userId]);await connection.execute("INSERT INTO vehicle_interagency_transfer_history(transfer_id,old_status,new_status,reason,performed_by) VALUES(?,'PENDING_SHIPMENT','IN_TRANSIT','Expédition confirmée',?)",[transferId,context.userId]);return String(movement.insertId)});await requireBusinessArchive(`vehicle-movement:${movementId}:posted`,()=>archiveVehicleMovement(movementId,request.user!.sub));response.json({id:transferId,status:'IN_TRANSIT',movementId});}));
    
    vehicleRouter.post('/vehicle-interagency-transfers/:id/receive',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{const transferId=idOf(request.params.id),locationId=String(integer(request.body.locationId,'Emplacement de réception',true));const result=await withCurrentAgencyBusinessAuthorization(request,'vehicles.assign_agency',async(connection,context)=>{const[rows]=await connection.execute<RowDataPacket[]>('SELECT * FROM vehicle_interagency_transfers WHERE id=? FOR UPDATE',[transferId]),transfer=rows[0];if(!transfer)throw new HttpError(404,'Transfert introuvable');if(String(transfer.destination_agency_id)!==context.activeAgencyId)throw new HttpError(403,'Réception hors de l’agence destination active');if(transfer.status==='RECEIVED')return{status:'RECEIVED',movementId:null};if(transfer.status!=='IN_TRANSIT')throw new HttpError(409,'Seul un transfert en transit peut être réceptionné');const validLocationId=await vehicleLocation(connection,context.activeAgencyId!,locationId);const[vehicles]=await connection.execute<RowDataPacket[]>('SELECT agency_id,status FROM vehicles WHERE id=? FOR UPDATE',[transfer.vehicle_id]),vehicle=vehicles[0];if(!vehicle||String(vehicle.agency_id)!==String(transfer.source_agency_id)||vehicle.status!=='in_transit')throw new HttpError(409,'État physique du véhicule incompatible avec la réception');const receivedStatus=transfer.original_vehicle_status==='available'?'received':transfer.original_vehicle_status;await connection.execute("UPDATE vehicle_interagency_transfers SET status='RECEIVED',destination_location_id=?,received_by=?,received_at=NOW(),version=version+1 WHERE id=?",[validLocationId,context.userId,transferId]);await connection.execute('UPDATE vehicles SET agency_id=?,vehicle_location_id=?,status=? WHERE id=?',[context.activeAgencyId,validLocationId,receivedStatus,transfer.vehicle_id]);await connection.execute('INSERT INTO vehicle_status_history(vehicle_id,old_status,new_status,changed_by,reason) VALUES(?,?,?,?,?)',[transfer.vehicle_id,'in_transit',receivedStatus,context.userId,'Réception transfert inter-agences']);const[movement]=await connection.execute<ResultSetHeader>(`INSERT INTO vehicle_movements(vehicle_id,to_vehicle_location_id,from_agency_id,to_agency_id,movement_type,reference_type,reference_id,reason,performed_by) VALUES(?,?,?,?,'transfer','vehicle_interagency_transfer',?,'Réception confirmée',?)`,[transfer.vehicle_id,validLocationId,transfer.source_agency_id,transfer.destination_agency_id,transferId,context.userId]);await connection.execute("INSERT INTO vehicle_interagency_transfer_history(transfer_id,old_status,new_status,reason,performed_by) VALUES(?,'IN_TRANSIT','RECEIVED','Réception confirmée',?)",[transferId,context.userId]);return{status:'RECEIVED',movementId:String(movement.insertId)}});if(result.movementId)await requireBusinessArchive(`vehicle-movement:${result.movementId}:posted`,()=>archiveVehicleMovement(result.movementId!,request.user!.sub));response.json({id:transferId,...result});}));
    
    vehicleRouter.post('/vehicle-interagency-transfers/:id/cancel',requireAgencyBusinessPermission('vehicles.assign_agency'),asyncHandler(async(request,response)=>{const transferId=idOf(request.params.id),reason=txt(request.body.reason,500);if(!reason)throw new HttpError(400,'Le motif d’annulation est obligatoire');const status=await withCurrentAgencyBusinessAuthorization(request,'vehicles.assign_agency',async(connection,context)=>{const[rows]=await connection.execute<RowDataPacket[]>('SELECT * FROM vehicle_interagency_transfers WHERE id=? FOR UPDATE',[transferId]),transfer=rows[0];if(!transfer)throw new HttpError(404,'Transfert introuvable');if(String(transfer.source_agency_id)!==context.activeAgencyId)throw new HttpError(403,'Annulation hors agence source');if(transfer.status==='CANCELLED')return'CANCELLED';if(transfer.status==='RECEIVED')throw new HttpError(409,'Un transfert reçu ne peut plus être annulé');const next=transfer.status==='IN_TRANSIT'?'RETURN_REQUIRED':'CANCELLED';await connection.execute('UPDATE vehicle_interagency_transfers SET status=?,cancelled_by=?,cancelled_at=NOW(),cancellation_reason=?,version=version+1 WHERE id=?',[next,context.userId,reason,transferId]);await connection.execute('INSERT INTO vehicle_interagency_transfer_history(transfer_id,old_status,new_status,reason,performed_by) VALUES(?,?,?,?,?)',[transferId,transfer.status,next,reason,context.userId]);return next});response.json({id:transferId,status});}));
    
