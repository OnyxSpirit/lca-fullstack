      "export function vehicleScope(request:Request,permission:string,alias='v',requested:unknown=request.query.agencyId){const value=grant(request,permission),agencyId=request.agencyRbac?.activeAgencyId;if(!agencyId)throw new HttpError(403,'Aucune agence active');if(value==='AGENCY'&&(requested==null||requested===''||String(requested)===agencyId))return{sql:`${alias}.agency_id=?`,params:[agencyId]};if(value==='OWN')throw new HttpError(403,'Le stock véhicules ne possède pas de règle OWN');throw new HttpError(403,`Scope AGENCY requis pour ${permission}`);}\n" +
