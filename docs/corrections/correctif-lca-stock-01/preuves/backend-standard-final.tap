      response.json({total:Number(row?.total??0),park:Number(row?.park??0),showroom:Number(row?.showroom??0),garage:Number(row?.garage??0),unassigned:Number(row?.unassigned??0)});
    }));
    
    vehicleRouter.get('/vehicles/agencies/create',requireAgencyBusinessPermission('vehicles.create'),asyncHandler(async(request,response)=>{
      const current=request.agencyRbac!.activeAgencyId!;
      const rows=await query<RowDataPacket[]>('SELECT a.id,a.name,a.code,c.currency_code FROM agencies a JOIN concessions c ON c.id=a.concession_id WHERE a.is_active=TRUE AND a.id=?',[current]);
      response.json(rows.map(row=>({id:String(row.id),name:String(row.name),code:String(row.code),currencyCode:String(row.currency_code??'XAF'),financialAllowed:grant(request,'vehicles.financials.view')==='AGENCY'})));
    }));
    
    const baseSelect=`SELECT v.*,COALESCE(ve.name,v.identity_version) version,COALESCE(m.id,vo.model_id) model_id,COALESCE(m.name,v.identity_model,om.name) model,COALESCE(b.id,vo.brand_id) brand_id,COALESCE(b.name,v.identity_brand,ob.name) brand,a.name agency_name,c.currency_code,vl.name location_name,vl.type location_type,vl.is_active location_active,s.name supplier_name,CONCAT_WS(' ',u.first_name,u.last_name) created_by_name,(SELECT vi.file_path FROM vehicle_images vi WHERE vi.vehicle_id=v.id ORDER BY vi.is_primary DESC,vi.sort_order,vi.id LIMIT 1) primary_image FROM vehicles v LEFT JOIN versions ve ON ve.id=v.version_id LEFT JOIN models m ON m.id=ve.model_id LEFT JOIN brands b ON b.id=m.brand_id LEFT JOIN vehicle_orders vo ON vo.id=v.vehicle_order_id LEFT JOIN models om ON om.id=vo.model_id LEFT JOIN brands ob ON ob.id=vo.brand_id JOIN agencies a ON a.id=v.agency_id JOIN concessions c ON c.id=a.concession_id LEFT JOIN vehicle_locations vl ON vl.id=v.vehicle_location_id LEFT JOIN suppliers s ON s.id=v.supplier_id LEFT JOIN users u ON u.id=v.created_by`;
    async function vehicleLocation(connection:PoolConnection,agencyId:string,value:unknown,allowInactive=false){const locationId=integer(value,'Affectation');if(locationId==null)return null;const[rows]=await connection.execute<RowDataPacket[]>(`SELECT id FROM vehicle_locations WHERE id=? AND agency_id=?${allowInactive?'':' AND is_active=TRUE'}`,[locationId,agencyId]);if(!rows[0])throw new HttpError(400,'Affectation véhicule invalide ou inactive pour cette agence');return locationId}
    async function vehicleSupplier(connection:PoolConnection,value:unknown){const supplierId=integer(value,'Fournisseur');if(supplierId==null)return null;const[rows]=await connection.execute<RowDataPacket[]>('SELECT id FROM suppliers WHERE id=? AND is_active=TRUE AND is_vehicle_supplier=TRUE',[supplierId]);if(!rows[0])throw new HttpError(400,'Fournisseur véhicule invalide, inactif ou non qualifié');return supplierId}
    export function assertStockVehicleMutable(status:unknown){
      if(['sold','delivered','in_transit'].includes(String(status)))throw new HttpError(409,'Un véhicule vendu, livré ou en transit est verrouillé dans Stock Véhicules');
    }
    export function mapVehicle(row:RowDataPacket,finance=Boolean(row.financial_allowed)){const warrantyAssignment=row.warranty_assigned_at==null?null:row.warranty_provider_id==null?{hasWarranty:false,assignedAt:row.warranty_assigned_at}:{hasWarranty:true,providerId:String(row.warranty_provider_id),providerCode:String(row.warranty_provider_code_snapshot??''),providerName:String(row.warranty_provider_name_snapshot??''),durationMonths:row.warranty_duration_months_snapshot==null?null:Number(row.warranty_duration_months_snapshot),mileageLimit:row.warranty_mileage_limit_snapshot==null?null:Number(row.warranty_mileage_limit_snapshot),terms:row.warranty_terms_snapshot??null,assignedAt:row.warranty_assigned_at};const result:any={id:String(row.id),vin:row.vin,stockNumber:row.stock_number,registrationNumber:row.registration_number,vehicleType:row.vehicle_type,bodyType:row.body_type,year:row.year,firstRegistrationDate:row.first_registration_date,color:row.color,interiorColor:row.interior_color,fuelType:row.fuel_type,engine:row.engine,transmission:row.transmission,fiscalPower:row.fiscal_power,realPower:row.real_power,co2Emissions:row.co2_emissions,mileage:Number(row.mileage??0),status:row.status,entryDate:row.entry_date,notes:row.notes,technicalOverrides:parseTechnicalValues(row.technical_overrides),technicalSnapshot:row.technical_snapshot?jsonField(row.technical_snapshot,{}):null,technicalFrozenAt:row.technical_frozen_at??null,warrantyAssignment,brandId:row.brand_id==null?'':String(row.brand_id),brand:row.brand,modelId:row.model_id==null?'':String(row.model_id),model:row.model,versionId:row.version_id==null?'':String(row.version_id),version:row.version,vehicleOrderId:row.vehicle_order_id==null?null:String(row.vehicle_order_id),agencyId:String(row.agency_id),agencyName:row.agency_name,currencyCode:String(row.currency_code??'XAF'),locationId:row.vehicle_location_id==null?null:String(row.vehicle_location_id),locationName:row.location_name,locationType:row.location_type,locationActive:row.location_active==null?null:Boolean(row.location_active),supplierId:row.supplier_id==null?null:String(row.supplier_id),supplierName:row.supplier_name,createdById:row.created_by==null?null:String(row.created_by),createdByName:row.created_by_name,primaryImage:row.primary_image,createdAt:row.created_at,updatedAt:row.updated_at,catalogPrice:Number(row.catalog_price??0),salePrice:Number(row.sale_price??0),hasReceptionDefect:Boolean(row.reception_defect_present),receptionDefectDescription:row.reception_defect_description??null};if(finance)Object.assign(result,{purchasePrice:Number(row.purchase_price??0),refurbishmentCost:Number(row.refurbishment_cost??0),transportCost:Number(row.transport_cost??0),administrativeCost:Number(row.administrative_cost??0),additionalCosts:Number(row.additional_costs??0),minimumPrice:Number(row.minimum_price??0),discount:Number(row.discount??0),receptionInitialSalePrice:row.reception_initial_sale_price==null?null:Number(row.reception_initial_sale_price),receptionDefectDiscount:Number(row.reception_defect_discount??0),receptionDefectDiscountReason:row.reception_defect_discount_reason??null});return result;}
    const vehicleReadSelect=(request:Request)=>{const finance=permissionScopePredicate(request,'vehicles.financials.view',{agency:'v.agency_id'});return{sql:baseSelect.replace(' FROM vehicles',`,${finance?`IF(${finance.sql},1,NULL)`:'NULL'} financial_allowed FROM vehicles`),params:finance?.params??[]}};
    async function accessible(id:string,request:Request,permission='vehicles.view'){const scoped=vehicleScope(request,permission),select=vehicleReadSelect(request);const [row]=await query<RowDataPacket[]>(`${select.sql} WHERE v.id=? AND ${commercialStockPredicate()} AND v.archived_at IS NULL AND ${scoped.sql}`,[...select.params,id,...scoped.params]);if(!row)throw new HttpError(404,'Véhicule introuvable');return row;}
    async function notify(request:Request,vehicleId:string,agencyId:string,event:string,subject:string,message:string){emitToAgency(agencyId,event,{vehicleId,agencyId});if(!['vehicles:created','vehicles:status-changed','vehicles:transferred'].includes(event))return;await notifyPermissions({agencyId,permissions:['vehicles.view'],excludeUserIds:[request.user!.sub],subject,message,eventType:event.replace(':','.'),referenceType:'vehicle',referenceId:vehicleId,priority:event==='vehicles:transferred'?'high':'normal',actorType:'human',actorUserId:request.user!.sub})}
    
    async function writeCommonTechnicalProfile(connection:PoolConnection,request:Request,versionId:string|number,values:Record<string,unknown>,expectedRevision?:unknown){
      await assertCentralAgencyPermission(request,'vehicles.catalog.manage');
      if(request.body.confirmSharedProfile!==true)throw new HttpError(409,'La modification du profil commun doit être confirmée explicitement');
      const clean=parseTechnicalValues(values),[rows]=await connection.execute<RowDataPacket[]>('SELECT * FROM commercial_models WHERE version_id=? FOR UPDATE',[versionId]),before=rows[0];
      if(before){const revision=Number(expectedRevision);if(!Number.isInteger(revision)||revision!==Number(before.revision))throw new HttpError(409,'Le profil commun a été modifié. Rechargez les données.');const entries=Object.entries(clean);if(entries.length){await connection.execute(`UPDATE commercial_models SET ${entries.map(([key])=>`${key}=?`).join(',')},revision=revision+1,updated_by=? WHERE id=?`,[...entries.map(([,value])=>value==null?null:keyJson(value)),request.user!.sub,before.id] as any[]);await writeAudit(connection,request,{module:'vehicles',entityType:'commercial_model',entityId:String(before.id),action:'technical_profile.updated_from_stock',oldValues:Object.fromEntries(entries.map(([key])=>[key,before[key]])),newValues:clean,context:{mode:'GLOBAL',note:'Modification commune confirmée depuis le stock'}})}}
      else{const entries=Object.entries(clean);if(!entries.length)return;const[result]=await connection.execute<ResultSetHeader>(`INSERT INTO commercial_models(version_id,${entries.map(([key])=>key).join(',')},catalog_price,currency_code,created_by,updated_by) VALUES(?,${entries.map(()=>'?').join(',')},0,'XAF',?,?)`,[versionId,...entries.map(([,value])=>keyJson(value)),request.user!.sub,request.user!.sub] as any[]);await writeAudit(connection,request,{module:'vehicles',entityType:'commercial_model',entityId:String(result.insertId),action:'technical_profile.created_from_stock',newValues:clean,context:{mode:'GLOBAL',note:'Création commune confirmée depuis le stock'}})}
    }
    function keyJson(value:unknown){return value!=null&&typeof value==='object'?JSON.stringify(value):value}
    export function warrantyTerms(months:number,mileage:number|null){return`Garantie constructeur : ${months} mois${mileage?` ou ${mileage.toLocaleString('fr-FR')} km`:''}`}
    export async function resolveWarrantyAssignment(connection:PoolConnection,value:unknown){if(value==null||typeof value!=='object'||Array.isArray(value))throw new HttpError(400,'Attribution de garantie invalide');const input=value as Record<string,unknown>;if(input.hasWarranty===false)return null;if(input.hasWarranty!==true)throw new HttpError(400,'Indiquez si le véhicule bénéficie d’une garantie');const providerId=String(input.providerId??'');if(!/^[1-9]\d*$/.test(providerId))throw new HttpError(400,'Constructeur garant obligatoire');const[rows]=await connection.execute<RowDataPacket[]>('SELECT id,code,name,default_warranty_months,default_mileage_limit FROM warranty_providers WHERE id=? AND is_active=TRUE AND warranty_available=TRUE AND default_warranty_months IS NOT NULL FOR UPDATE',[providerId]),provider=rows[0];if(!provider)throw new HttpError(409,'Ce constructeur ne possède plus de garantie active admissible');const months=Number(provider.default_warranty_months),mileage=provider.default_mileage_limit==null?null:Number(provider.default_mileage_limit);return{providerId:String(provider.id),code:String(provider.code),name:String(provider.name),months,mileage,terms:warrantyTerms(months,mileage)}}
    async function persistWarrantyAssignment(connection:PoolConnection,vehicleId:string,value:unknown,userId:string){const assignment=await resolveWarrantyAssignment(connection,value);if(!assignment){await connection.execute('UPDATE vehicles SET warranty_provider_id=NULL,warranty_provider_code_snapshot=NULL,warranty_provider_name_snapshot=NULL,warranty_duration_months_snapshot=NULL,warranty_mileage_limit_snapshot=NULL,warranty_terms_snapshot=NULL,warranty_assigned_at=NOW(),warranty_assigned_by=? WHERE id=?',[userId,vehicleId]);return null}await connection.execute('UPDATE vehicles SET warranty_provider_id=?,warranty_provider_code_snapshot=?,warranty_provider_name_snapshot=?,warranty_duration_months_snapshot=?,warranty_mileage_limit_snapshot=?,warranty_terms_snapshot=?,warranty_assigned_at=NOW(),warranty_assigned_by=? WHERE id=?',[assignment.providerId,assignment.code,assignment.name,assignment.months,assignment.mileage,assignment.terms,userId,vehicleId]);return assignment}
    function withWarrantyTechnical(effective:any,vehicle:RowDataPacket){if(vehicle.warranty_provider_id==null)return effective;return{...effective,values:{...effective.values,warranty_text:vehicle.warranty_terms_snapshot,warranty_duration_months:vehicle.warranty_duration_months_snapshot,warranty_mileage_limit_km:vehicle.warranty_mileage_limit_snapshot},origins:{...effective.origins,warranty_text:'individual',warranty_duration_months:'individual',warranty_mileage_limit_km:'individual'}}}
    
    vehicleRouter.get('/documents/business/vehicle/:id/pdf',requireAgencyBusinessPermission('vehicles.view'),asyncHandler(async(request,response)=>{
      const id=idOf(request.params.id),row=await accessible(id,request),data=mapVehicle(row),profile=row.version_id==null?null:await resolveTechnicalProfileByVersion(pool,String(row.version_id));
      const technical=withWarrantyTechnical(effectiveTechnicalValues(['sold','delivered'].includes(String(row.status))&&!row.technical_snapshot?null:profile,row.technical_overrides,row.technical_snapshot),row);
      const[imageRows,featureRows]=await Promise.all([
        query<RowDataPacket[]>('SELECT id,file_path,mime_type,sort_order,is_primary FROM vehicle_images WHERE vehicle_id=? ORDER BY is_primary DESC,sort_order,id',[id]),
        query<RowDataPacket[]>('SELECT vf.name FROM vehicle_feature_assignments vfa JOIN vehicle_features vf ON vf.id=vfa.feature_id WHERE vfa.vehicle_id=? ORDER BY vf.name',[id]),
      ]);
      const images=await Promise.all(imageRows.map(async image=>{try{return{id:String(image.id),path:String(image.file_path),isPrimary:Boolean(image.is_primary),buffer:await readDocumentFile(String(image.file_path))}}catch(error){return{id:String(image.id),path:String(image.file_path),isPrimary:Boolean(image.is_primary),error:error instanceof Error?error.message:'Photographie illisible'}}}));
      const pdf=await renderVehicleDocumentData({...data,technicalValues:technical.values,features:featureRows.map(item=>String(item.name)),images});
      response.setHeader('Content-Type','application/pdf');response.setHeader('Content-Disposition',`${request.query.download==='true'?'attachment':'inline'}; filename="fiche-vehicule-${data.stockNumber}.pdf"`);response.send(pdf);
    }));
    
    vehicleRouter.get('/vehicle-references',requireAnyAgencyBusinessPermission(['vehicles.view','vehicles.create']),asyncHandler(async(request,response)=>{const permission=grant(request,'vehicles.view')?'vehicles.view':grant(request,'vehicles.create')?'vehicles.create':null;if(!permission)throw new HttpError(403,'Permission de consultation ou de création véhicule requise');const agencyId=await agency(request,permission,request.query.agencyId);const [brands,models,versions,locations,suppliers,features]=await Promise.all([query<RowDataPacket[]>('SELECT id,name,code FROM brands WHERE is_active=TRUE ORDER BY name'),query<RowDataPacket[]>('SELECT id,brand_id,name,code FROM models WHERE is_active=TRUE ORDER BY name'),query<RowDataPacket[]>('SELECT id,model_id,name,engine,fuel_type,transmission,power FROM versions WHERE is_active=TRUE ORDER BY name'),query<RowDataPacket[]>('SELECT id,agency_id,name,type FROM vehicle_locations WHERE is_active=TRUE AND agency_id=? ORDER BY type,name',[agencyId]),query<RowDataPacket[]>('SELECT id,name,code FROM suppliers WHERE is_active=TRUE AND is_vehicle_supplier=TRUE ORDER BY name'),query<RowDataPacket[]>('SELECT id,name FROM vehicle_features WHERE is_active=TRUE ORDER BY name')]);response.json({brands,models,versions,locations,suppliers,features});}));
    vehicleRouter.get('/vehicles/warranty-providers/eligible',requireAnyAgencyBusinessPermission(['vehicles.create','vehicles.update','vehicles.view']),asyncHandler(async(request,response)=>{
      if(!grant(request,'vehicles.create')&&!grant(request,'vehicles.update')&&!grant(request,'vehicles.view'))throw new HttpError(403,'Permission véhicule requise');
      const rows=await query<RowDataPacket[]>('SELECT id,code,name,default_warranty_months duration_months,default_mileage_limit mileage_limit FROM warranty_providers WHERE is_active=TRUE AND warranty_available=TRUE AND default_warranty_months IS NOT NULL ORDER BY name');
      response.json(rows.map(row=>({id:String(row.id),code:String(row.code),name:String(row.name),durationMonths:Number(row.duration_months),mileageLimit:row.mileage_limit==null?null:Number(row.mileage_limit),terms:warrantyTerms(Number(row.duration_months),row.mileage_limit==null?null:Number(row.mileage_limit))})));
    }));
    
    vehicleRouter.get('/vehicles/filter-options',requireAgencyBusinessPermission('vehicles.view'),asyncHandler(async(request,response)=>{
      const scoped=vehicleScope(request,'vehicles.view');
      const view=txt(request.query.view)||'active';
      const viewSql=vehicleInventoryViewSql(view);
      const brandId=txt(request.query.brandId);
      if(brandId&&!/^[1-9]\d*$/.test(brandId))throw new HttpError(400,'Filtre marque invalide');
      const locationType=txt(request.query.locationType);if(locationType&&!isVehicleLocationType(locationType))throw new HttpError(400,"Type d'affectation invalide");
      const [brands,models,locations]=await Promise.all([
        query<RowDataPacket[]>(`SELECT DISTINCT b.id,b.name FROM vehicles v JOIN versions ve ON ve.id=v.version_id JOIN models m ON m.id=ve.model_id JOIN brands b ON b.id=m.brand_id WHERE ${commercialStockPredicate()} AND v.archived_at IS NULL AND ${scoped.sql}${viewSql} ORDER BY b.name`,scoped.params),
        query<RowDataPacket[]>(`SELECT DISTINCT m.id,m.brand_id,m.name FROM vehicles v JOIN versions ve ON ve.id=v.version_id JOIN models m ON m.id=ve.model_id WHERE ${commercialStockPredicate()} AND v.archived_at IS NULL AND ${scoped.sql}${viewSql}${brandId?' AND m.brand_id=?':''} ORDER BY m.name`,brandId?[...scoped.params,brandId]:scoped.params),
        query<RowDataPacket[]>(`SELECT DISTINCT vl.id,vl.name,vl.type,vl.agency_id,a.name agency_name FROM vehicle_locations vl JOIN agencies a ON a.id=vl.agency_id WHERE vl.is_active=TRUE AND ${vehicleScope(request,'vehicles.view','vl').sql}${locationType?' AND vl.type=?':''} ORDER BY vl.type,vl.name`,[...vehicleScope(request,'vehicles.view','vl').params,...(locationType?[locationType]:[])]),
      ]);
      response.json({brands:brands.map(row=>({id:String(row.id),name:String(row.name)})),models:models.map(row=>({id:String(row.id),brandId:String(row.brand_id),name:String(row.name)})),locations:locations.map(row=>({id:String(row.id),name:String(row.name),type:String(row.type),agencyId:String(row.agency_id),agencyName:String(row.agency_name)}))});
    }));
    
    vehicleRouter.get('/vehicles',requireAgencyBusinessPermission('vehicles.view'),asyncHandler(async(request,response)=>{
      const scoped=vehicleScope(request,'vehicles.view'),clauses=[scoped.sql,commercialStockPredicate(),'v.archived_at IS NULL'],params:unknown[]=[...scoped.params];
      const requestedStatus=txt(request.query.status),view=txt(request.query.view)||'active';
      vehicleInventoryViewSql(view);
      const excludeTestDriveReserved=txt(request.query.excludeTestDriveReserved);
      if(excludeTestDriveReserved&&excludeTestDriveReserved!=='true')throw new HttpError(400,'Filtre de disponibilité essai invalide');
      if(excludeTestDriveReserved==='true')clauses.push("NOT EXISTS(SELECT 1 FROM showroom_test_drives active_drive WHERE active_drive.vehicle_id=v.id AND active_drive.status IN('planned','in_progress'))");
      if(!requestedStatus){if(view==='active')clauses.push("v.status NOT IN('sold','delivered')");if(view==='sold')clauses.push("v.status IN('sold','delivered')");}
      for(const [key,column,allowed] of [['status','v.status',DB_STATUSES],['type','v.vehicle_type',ACTIVE_TYPES]] as const){const value=txt(request.query[key]);if(value){if(!allowed.includes(value as never))throw new HttpError(400,`Filtre ${key} invalide`);clauses.push(`${column}=?`);params.push(value)}}
      const orderId=txt(request.query.vehicleOrderId),presence=txt(request.query.presence);if(orderId){if(!/^[1-9]\d*$/.test(orderId))throw new HttpError(400,'Filtre commande invalide');clauses.push('v.vehicle_order_id=?');params.push(orderId)}const receiptExists=`EXISTS(SELECT 1 FROM vehicle_order_receipts vor WHERE vor.vehicle_order_id=v.vehicle_order_id AND JSON_CONTAINS(vor.vehicle_ids,JSON_QUOTE(CAST(v.id AS CHAR))))`;if(presence==='physical')clauses.push(`(v.vehicle_order_id IS NULL AND v.entry_date IS NOT NULL OR v.vehicle_order_id IS NOT NULL AND ${receiptExists})`);else if(presence==='ordered')clauses.push(`(v.vehicle_order_id IS NOT NULL AND NOT ${receiptExists})`);else if(presence)throw new HttpError(400,'Filtre de présence invalide');
      for(const [key,column,label] of [['brandId','COALESCE(b.id,vo.brand_id)','marque'],['modelId','COALESCE(m.id,vo.model_id)','modèle']] as const){const value=txt(request.query[key]);if(value){if(!/^[1-9]\d*$/.test(value))throw new HttpError(400,`Filtre ${label} invalide`);clauses.push(`${column}=?`);params.push(value)}}
      const fuel=txt(request.query.fuel);if(fuel){clauses.push('v.fuel_type=?');params.push(fuel)}const locationType=txt(request.query.locationType);if(locationType){if(!isVehicleLocationType(locationType))throw new HttpError(400,"Type d'affectation invalide");clauses.push('vl.type=?');params.push(locationType)}const assignment=txt(request.query.assignment);if(assignment==='unassigned'){clauses.push(`v.vehicle_location_id IS NULL AND (v.vehicle_order_id IS NULL OR ${receiptExists})`)}else if(assignment){if(!/^[1-9]\d*$/.test(assignment))throw new HttpError(400,'Affectation invalide');clauses.push('v.vehicle_location_id=?');params.push(assignment)}const dormant=txt(request.query.dormant);if(dormant==='true')clauses.push(`v.entry_date<DATE_SUB(CURDATE(),INTERVAL 60 DAY) AND (v.vehicle_order_id IS NULL OR ${receiptExists})`);const search=txt(request.query.search,120);if(search){const term=`%${search}%`;clauses.push(`(COALESCE(b.name,v.identity_brand,ob.name) LIKE ? OR COALESCE(m.name,v.identity_model,om.name) LIKE ? OR COALESCE(ve.name,v.identity_version) LIKE ? OR v.vin LIKE ? OR v.stock_number LIKE ? OR v.registration_number LIKE ?)`);params.push(term,term,term,term,term,term)}
      const{minPrice,maxPrice}=vehiclePriceRange(request.query.minPrice,request.query.maxPrice);if(minPrice!=null){clauses.push('v.sale_price>=?');params.push(minPrice)}if(maxPrice!=null){clauses.push('v.sale_price<=?');params.push(maxPrice)}
