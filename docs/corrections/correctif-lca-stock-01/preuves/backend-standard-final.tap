      "export function vehicleOrderSql(value:unknown){const sort=txt(value)||'date_desc',orders:Record<string,string>={date_desc:'v.entry_date DESC,v.id DESC',date_asc:'v.entry_date ASC,v.id ASC',brand:'b.name ASC,m.name ASC,v.id ASC',model:'m.name ASC,b.name ASC,v.id ASC',price_asc:'v.sale_price ASC,v.id ASC',price_desc:'v.sale_price DESC,v.id DESC'};if(!Object.hasOwn(orders,sort))throw new HttpError(400,'Tri de stock invalide');return orders[sort]!}\n" +
      '\n' +
      "const locationScope=(request:Request,permission:string,alias='vl',requested:unknown=request.query.agencyId)=>vehicleScope(request,permission,alias,requested);\n" +
