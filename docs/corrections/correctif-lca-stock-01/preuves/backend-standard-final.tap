      "const assertCostTotal=(values:unknown[])=>{const total=values.reduce<number>((sum,value)=>sum+Number(value??0),0);if(!Number.isFinite(total)||total>9999999999999999.99)throw new HttpError(400,'Le coût de revient total dépasse la capacité autorisée');};\n" +
      "const integer=(value:unknown,name:string,required=false)=>{if((value==null||value==='')&&!required)return null;const parsed=Number(value);if(!Number.isInteger(parsed)||parsed<0)throw new HttpError(400,`${name} doit être un entier positif`);return parsed;};\n" +
