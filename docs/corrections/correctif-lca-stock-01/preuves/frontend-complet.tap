      'const CreatableReferenceField:React.FC<{label:string;items:Array<{id:string;name:string}>;value:string;selectedId:string;isNew:boolean;disabled?:boolean;onChange:(value:string,id:string,isNew:boolean)=>void}>=({label,items,value,selectedId,isNew,disabled,onChange})=>{const listId=`order-${label.toLocaleLowerCase(\'fr\')}`,clean=value.trim().replace(/\\s+/g,\' \'),exact=items.find(item=>normalized(item.name)===normalized(clean));return <label className="text-xs font-semibold">{label} *<input list={listId} disabled={disabled} className="mt-1 w-full rounded border p-2 disabled:bg-slate-100" value={value} placeholder={`Rechercher ou saisir ${label.toLocaleLowerCase(\'fr\')}…`} onChange={event=>{const next=event.target.value,match=items.find(item=>normalized(item.name)===normalized(next));onChange(next,match?.id??\'\',false)}}/><datalist id={listId}>{items.map(item=><option key={item.id} value={item.name}/>)}</datalist>{clean&&!exact&&!isNew&&<button type="button" className="mt-1 text-left text-xs font-bold text-[#8f1722]" onClick={()=>onChange(clean,\'\',true)}>+ Ajouter « {clean} »</button>}{selectedId&&<span className="mt-1 block font-normal text-emerald-700">Référence existante sélectionnée.</span>}{isNew&&<span className="mt-1 block font-normal text-blue-700">Nouvelle référence à créer lors de la validation.</span>}</label>};\n' +
      'export const CommercialCatalogPage:React.FC<{embedded?:boolean}>=({embedded=false})=>{\n' +
      " const canManage=useAuthStore(s=>s.can('vehicles.catalog.manage')),agencyId=useAuthStore(s=>s.currentAgency?.id),toast=useUiStore(s=>s.addToast),navigate=useNavigate();\n" +
      " const[page,setPage]=useState(1),[pageSize,setPageSize]=useState(10),[search,setSearch]=useState(''),[brandId,setBrandId]=useState(''),[modelId,setModelId]=useState(''),[status,setStatus]=useState(''),[creating,setCreating]=useState(false),[detailId,setDetailId]=useState<string>(),[receiptOrder,setReceiptOrder]=useState<VehicleOrder>(),[receiptQuantity,setReceiptQuantity]=useState('1');\n" +
      " const[form,setForm]=useState({brandId:'',brandName:'',brandNew:false,modelId:'',modelName:'',modelNew:false,versionId:'',quantity:'1'}),[illustration,setIllustration]=useState<File>(),createKey=useRef(uuid()),receiptKey=useRef(uuid()),deferredSearch=useDeferredValue(search),references=useVehicleOrderReferencesQuery(),orders=useVehicleOrdersQuery({page,pageSize,search:deferredSearch,brandId,modelId,status,agencyId}),detail=useVehicleOrderQuery(detailId),actions=useVehicleOrderActions();\n" +
      ' const models=useMemo(()=>references.data?.models.filter(item=>!brandId||item.brandId===brandId)??[],[references.data,brandId]),versions=useMemo(()=>references.data?.versions.filter(item=>item.modelId===form.modelId)??[],[references.data,form.modelId]),formModels=useMemo(()=>form.brandId?references.data?.models.filter(item=>item.brandId===form.brandId)??[]:[],[references.data,form.brandId]);useEffect(()=>setPage(1),[deferredSearch,brandId,modelId,status,agencyId]);\n' +
      " const fail=(title:string,error:unknown)=>toast({type:'error',title,description:error instanceof Error?error.message:'Erreur API'});\n" +
      " const create=async()=>{try{if((!form.brandId&&!form.brandNew)||(!form.modelId&&!form.modelNew))throw new Error('Sélectionnez une référence existante ou confirmez explicitement son ajout.');const quantity=Number(form.quantity);if(!Number.isInteger(quantity)||quantity<1||quantity>1000)throw new Error('La quantité doit être un entier de 1 à 1 000.');const image=illustration?await optimizeImage(illustration):undefined;await actions.create.mutateAsync({...(form.brandId?{brandId:form.brandId}:{brandName:form.brandName}),...(form.modelId?{modelId:form.modelId}:{modelName:form.modelName}),versionId:form.versionId||undefined,quantity,clientRequestId:createKey.current,...(image?{illustration:{dataUrl:image.dataUrl,name:image.name}}:{})});createKey.current=uuid();setCreating(false);setIllustration(undefined);setForm({brandId:'',brandName:'',brandNew:false,modelId:'',modelName:'',modelNew:false,versionId:'',quantity:'1'});toast({type:'success',title:'Commande enregistrée',description:'Les références et les fiches individuelles sont à jour.'})}catch(error){fail('Commande impossible',error)}};\n" +
