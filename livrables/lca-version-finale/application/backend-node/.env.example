NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
GED_STORAGE_DIR=ged-storage
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=concession_erp
DB_POOL_SIZE=10
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 0 en accès local direct ; indiquez le nombre exact de reverse proxies en production.
TRUST_PROXY_HOPS=0
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_IP_RATE_LIMIT_MAX=120
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=120
UPLOAD_DIR=uploads
