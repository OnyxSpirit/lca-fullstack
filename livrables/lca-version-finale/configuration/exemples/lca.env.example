# Copiez ce fichier vers .env sur le VPS. Ne commitez jamais .env.
COMPOSE_PROJECT_NAME=lca
MYSQL_DATABASE=concession_erp
MYSQL_USER=lca_app
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
DB_POOL_SIZE=10
JWT_ACCESS_SECRET=replace_with_at_least_64_random_characters
JWT_REFRESH_SECRET=replace_with_another_64_random_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 1 avec le Nginx Docker seul ; 2 si deploy/nginx-host.conf.example est aussi utilisé.
TRUST_PROXY_HOPS=1
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_IP_RATE_LIMIT_MAX=120
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=120
# Premier test IP : http://IP_DU_VPS ; production : https://erp.domaine-client.tld
FRONTEND_URL=http://IP_DU_VPS
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
# Utilisé uniquement par `docker compose run --rm seed-admin`.
ADMIN_EMAIL=replace_with_initial_admin_email
ADMIN_PASSWORD=replace_with_a_strong_initial_password
ADMIN_ROTATE_PASSWORD=false
